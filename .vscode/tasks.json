{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ARM64: Build QEMU",
            "type": "shell",
            "command": "make",
            "args": [
                "MODE=qemu",
                "all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "ARM64: Run QEMU",
            "type": "shell",
            "command": "make",
            "args": [
                "MODE=qemu",
                "run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ARM64: QEMU GDB Server",
            "type": "shell",
            "command": "make",
            "args": [
                "MODE=qemu",
                "debug-server"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "ARM64: Build Native",
            "type": "shell",
            "command": "make",
            "args": [
                "MODE=native",
                "all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ARM64: Run Native",
            "type": "shell",
            "command": "make",
            "args": [
                "MODE=native",
                "run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ARM64: Clean",
            "type": "shell",
            "command": "make",
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
